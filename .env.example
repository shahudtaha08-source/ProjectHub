# ProjectHub configuration
# Copy to .env. Never commit the real .env.

PROJECT_HUB=

# GitHub automation
GITHUB_OWNER=shahudtaha08-source
# Required only for creating missing GitHub repositories or verifying private remotes.
# Existing local Git repositories can still be initialized/committed without a token.
GITHUB_TOKEN=
GITHUB_VISIBILITY=private
# Set true only after GITHUB_TOKEN is configured to allow automatic repository creation.
AUTO_CREATE_REPOS=false

# Rename/move recovery
PROJECT_SEARCH_ROOTS=D:/projects

# Watcher
WATCH_INTERVAL_SECONDS=5
WATCH_DEBOUNCE_SECONDS=10

# Local Ollama (optional). Leave OLLAMA_MODEL blank to use deterministic fallback commit messages.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=
