# ProjectHub configuration
# Copy to .env. Never commit the real .env.

# Leave blank to use the folder containing main.py.
PROJECT_HUB=

# GitHub automation
# Default account used for newly created repositories.
GITHUB_OWNER=shahudtaha08-source
GITHUB_TOKEN=
GITHUB_VISIBILITY=private
AUTO_CREATE_REPOS=false

# Rename/move recovery
# Semicolon-separated folders ProjectHub should search when a registered project path is missing.
# Example: D:/projects;D:/Users/Taha;C:/Users/shahu/OneDrive
PROJECT_SEARCH_ROOTS=D:/projects

# Watcher
# Scan every 5 seconds. After a change, wait until changes have been quiet for 10 seconds.
WATCH_INTERVAL_SECONDS=5
WATCH_DEBOUNCE_SECONDS=10
